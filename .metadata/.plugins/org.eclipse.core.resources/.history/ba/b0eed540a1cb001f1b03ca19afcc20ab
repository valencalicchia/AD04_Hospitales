import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.hibernate.Transaction;

import Dtos.*;
import Helpers.*;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;


public class Ejercicio1 {

	/**
	 * Método principal que inicializa la sesión de Hibernate y ejecuta el proceso
	 * de inserción de nuevas salas.
	 * 
	 * @param args Argumentos de la línea de comandos (no utilizados).
	 */
	public static void main(String[] args) {
		SessionFactory factory = HibernateHelper.getSessionFactory();
		Session session = factory.openSession();
		System.out.println("Ejercicio 1 - Insertar Nuevas salas");
		System.out.println("Bajo Tabero Álvaro");
		System.out.println("=======================================");

		nuevasSalasBBDD(session);
	}

	/**
	 * Muestra un listado de las salas existentes en la base de datos, con
	 * información relevante.
	 * 
	 * @param session La sesión de Hibernate para interactuar con la base de datos.
	 */
	private static void listarSalas(Session session) {

		SalaHelper salaDao = new SalaHelper(session);
		HospitalesHelper hospitalDAO = new HospitalesHelper(session);
		List<Sala> lista = salaDao.getAll();
		Map<Byte, String> diccionarioHospital = hospitalDAO.traerIdAndNombre();

		System.out.println("=".repeat(85));
		System.out.println("LISTADO DE SALAS");
		System.out.println("=".repeat(85));
		System.out.printf("%-25s %-25s %10s %10s %10s%n", "HOSPITAL", "SALA", "CAMAS", "OCUPACIÓN", "PLANTILLA");
		System.out.println("=".repeat(85));

		int idActual = 0;
		for (Sala sa : lista) {
			if (idActual != sa.getId().getHospitalCod()) {
				idActual = sa.getId().getHospitalCod();
				if (idActual != 0) {
					System.out.println();
				}
			}

			String hospital = String.format("(%d) %s", sa.getId().getHospitalCod(),
					diccionarioHospital.get(sa.getId().getHospitalCod()));
			String sala = String.format("(%d) %s", sa.getId().getSalaCod(), sa.getNombre());
			String camas = String.format("%10s", sa.getNumCama());
			String ocupacion = String.format("%10s", sa.getOcupacions().size());
			String plantilla = String.format("%10s", sa.getPlantillas().size());

			camas = String.format("%-10s", camas).replace(' ', ' ');
			ocupacion = String.format("%-10s", ocupacion).replace(' ', ' ');
			plantilla = String.format("%-10s", plantilla).replace(' ', ' ');

			System.out.printf("%-25s %-25s %10s %10s %10s%n", hospital, sala, camas, ocupacion, plantilla);
		}

	}

	/**
	 * Guarda una lista de nuevas salas en la base de datos si cumplen con las
	 * condiciones.
	 * 
	 * @param nuevasSalasTranfort Lista de nuevas salas a insertar.
	 * @param session             La sesión de Hibernate para interactuar con la
	 *                            base de datos.
	 */
	private static void guardarNuevasSalas(List<Sala> nuevasSalasTranfort, Session session) {
		session.beginTransaction();
		HospitalesHelper hospitalesdao = new HospitalesHelper(session);
		SalaHelper salaDao = new SalaHelper(session);
		for (Sala sala : nuevasSalasTranfort) {
			System.out.println("Insertando (" + sala.getId().getHospitalCod() + ", " + sala.getId().getSalaCod() + ", "
					+ sala.getNombre() + ", " + sala.getNumCama() + ")");
			List<String> listaErrores = new ArrayList<String>();
			boolean error = false;
			if (salaDao.existSala(sala.getId())) {
				listaErrores.add(
						"sala(" + sala.getId().getHospitalCod() + ", " + sala.getId().getSalaCod() + ") YA EXISTE");
				error = true;
			}
			if (!hospitalesdao.existingHospital(sala.getId().getHospitalCod())) {
				listaErrores.add("Código de hospital " + sala.getId().getHospitalCod() + " no existe");
				error = true;
			}

			if (error) {
				for (String err : listaErrores) {
					System.out.print("\t" + err);
				}
				System.out.print(", No se insertará...\n");
				System.out.println();
			} else {
				salaDao.insertSala(sala);
				System.out.println("\tsala(" + sala.getId().getHospitalCod() + ", " + sala.getId().getSalaCod() + ") "
						+ "AÑADIDA...\n");
			}
		}
		session.getTransaction().commit();
		listarSalas(session);

	}

	/**
	 * Transforma una lista de nuevas salas en objetos de tipo Sala y los guarda en
	 * la base de datos.
	 * 
	 * @param salasNuevasAll Lista de nuevas salas a transformar.
	 * @param session        La sesión de Hibernate para interactuar con la base de
	 *                       datos.
	 */
	private static void transformarNuevasSalas(List<NuevasSalas> salasNuevasAll, Session session) {
		List<Sala> list = new ArrayList<Sala>();
		for (NuevasSalas a : salasNuevasAll) {
			list.add(createSala(a));
		}
		guardarNuevasSalas(list, session);
	}

	/**
	 * Crea un objeto de tipo Sala a partir de un objeto NuevasSalas.
	 * 
	 * @param a Objeto NuevasSalas.
	 * @return Un objeto Sala con la información transformada.
	 */
	private static Sala createSala(NuevasSalas a) {
		return new Sala(new SalaId(a.getId().getHospitalCod(), a.getId().getSalaCod()), null, a.getId().getNombre(),
				a.getId().getNumCama(), null, null);
	}

	/**
	 * Realiza el proceso completo de obtención e inserción de nuevas salas en la
	 * base de datos.
	 * 
	 * @param session La sesión de Hibernate para interactuar con la base de datos.
	 */
	private static void nuevasSalasBBDD(Session session) {
		NuevasSalasHelper nuevasSalasDao = new NuevasSalasHelper(session);
		List<NuevasSalas> nuevas = nuevasSalasDao.getAll();
		transformarNuevasSalas(nuevas, session);
	}
	
}
